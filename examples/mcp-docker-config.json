{
  "mcpServers": {
    "jianxi": {
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--memory", "1g", "--shm-size", "256m",
        "-e", "JIANXI_URL", "-e", "JIANXI_TOKEN",
        "jianxi-mcp:latest"
      ],
      "env": {
        "JIANXI_URL": "https://blog.example.com",
        "JIANXI_TOKEN": "REPLACE_WITH_YOUR_PRIVATE_MANAGEMENT_TOKEN"
      }
    }
  }
}
